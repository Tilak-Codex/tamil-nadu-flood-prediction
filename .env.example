# ============================================================
# AI-Based Flood Prediction System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit a .env file with real credentials to source control.

# --- Database ---
# SQLite (development, default):
DATABASE_URL=sqlite:///./data/flood_system.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/tn_flood_db

# --- FastAPI Server ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- ML Model Paths ---
MODEL_DIR=models/lstm
# MODEL_PATH=models/lstm/model.keras
# SCALERS_PATH=models/lstm/scalers.pkl

# --- Data Sources ---
# Open-Meteo (free, no key required)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# IMD (requires government registration — leave blank if unavailable)
IMD_API_KEY=
IMD_API_URL=

# India-WRIS (requires government credentials — leave blank if unavailable)
INDIA_WRIS_API_KEY=
INDIA_WRIS_API_URL=

# CWC (data obtained via manual CSV download — no live API key)
CWC_DATA_PATH=data/raw/

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=tn_flood_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
